<Window x:Class="JungleGame.UI.Views.StartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jungle Game — New Game"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/jungle.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Jungle (Dou Shou Qi)" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="{StaticResource GoldBrush}"/>

        <TextBlock Text="Who moves first?" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <RadioButton x:Name="HumanFirstRadio" Content="You (Human)" IsChecked="True"
                         GroupName="First" Margin="10,0"
                         AutomationProperties.Name="Human moves first"/>
            <RadioButton x:Name="AIFirstRadio" Content="AI Computer"
                         GroupName="First" Margin="10,0"
                         AutomationProperties.Name="AI moves first"/>
        </StackPanel>

        <TextBlock Text="AI difficulty" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <RadioButton x:Name="EasyRadio" Content="Easy (fast)"
                         GroupName="Difficulty" Margin="10,0"
                         AutomationProperties.Name="Easy difficulty"/>
            <RadioButton x:Name="MediumRadio" Content="Medium (1s)" IsChecked="True"
                         GroupName="Difficulty" Margin="10,0"
                         AutomationProperties.Name="Medium difficulty"/>
            <RadioButton x:Name="HardRadio" Content="Hard (2s)"
                         GroupName="Difficulty" Margin="10,0"
                         AutomationProperties.Name="Hard difficulty"/>
        </StackPanel>

        <CheckBox x:Name="AiVsAiCheck" Content="AI vs AI (watch mode)"
                  Margin="10,0,0,20"
                  AutomationProperties.Name="AI versus AI watch mode"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Start Game" Click="Start_Click" Width="120" Height="35"
                    Margin="10" Padding="12,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    AutomationProperties.Name="Start game"/>
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Height="35"
                    Margin="10" Padding="12,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel"/>
        </StackPanel>
    </StackPanel>
</Window>
