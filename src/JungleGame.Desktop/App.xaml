<Application x:Class="JungleGame.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:JungleGame.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Converters -->
        <converters:PlayerToBrushConverter x:Key="PlayerToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToFirstMoveIndexConverter x:Key="BoolToFirstMoveIndexConverter"/>

        <!-- Styles -->
        <Style TargetType="Button" x:Key="ToolbarButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="ToolbarComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <SolidColorBrush x:Key="StatusBarBg" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SidePanelBg" Color="#F5F5F0"/>
    </Application.Resources>
</Application>
