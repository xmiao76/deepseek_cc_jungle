<Window x:Class="JungleGame.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JungleGame.UI.Views"
        Title="Jungle (Dou Shou Qi / 鬥獸棋)" Width="780" Height="680"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" Foreground="White">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Board: the canvas keeps its 500×650 design size; the Viewbox scales
             it uniformly to the available space so the board grows and shrinks
             with the window at any resolution/DPI -->
        <Border Grid.Column="0" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0">
            <Viewbox Stretch="Uniform">
                <Canvas x:Name="BoardCanvas" Width="500" Height="650" Background="#3D2B1F"/>
            </Viewbox>
        </Border>

        <!-- Side Panel -->
        <StackPanel Grid.Column="1" Width="220" Margin="5">
            <!-- Title -->
            <TextBlock Text="Jungle" FontSize="26" FontWeight="Bold"
                       Foreground="#FFD700" HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Dou Shou Qi / 鬥獸棋" FontSize="13"
                       Foreground="#AAA" HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Status -->
            <Border Background="#2A2A3E" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="StatusLabel" FontSize="16" FontWeight="Bold"
                               Foreground="#FFD700" TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ThinkingIndicator" FontSize="13"
                               Foreground="#888" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <StackPanel Margin="0,5">
                <Button x:Name="NewGameBtn" Content="New Game" Click="NewGame_Click"
                        Height="36" Margin="0,3" FontSize="14"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Cursor="Hand"/>
                <Button x:Name="FlipBoardBtn" Content="Flip Board (180°)" Click="FlipBoard_Click"
                        Height="36" Margin="0,3" FontSize="14"
                        Background="#FF9800" Foreground="White" BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- Captured Pieces -->
            <Border Background="#2A2A3E" CornerRadius="5" Padding="10" Margin="0,10,0,5">
                <StackPanel>
                    <TextBlock Text="Captured" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Blue:" FontSize="12" Foreground="#1E90FF" Margin="0,0,5,0"/>
                        <TextBlock x:Name="CapturedBlueLabel" FontSize="12" Foreground="#AAA"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Red:" FontSize="12" Foreground="#DC143C" Margin="0,0,5,0"/>
                        <TextBlock x:Name="CapturedRedLabel" FontSize="12" Foreground="#AAA"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Move History -->
            <Border Background="#2A2A3E" CornerRadius="5" Padding="10" Margin="0,5,0,0">
                <StackPanel>
                    <TextBlock Text="Move Log" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MoveHistoryLabel" FontSize="11" Foreground="#AAA"
                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
