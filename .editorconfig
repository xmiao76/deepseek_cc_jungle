root = true

# ---- Global defaults ----
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xaml,xml,csproj,props,json,yml,yaml,md}]
indent_size = 2

# ---- C# ----
[*.cs]
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# WPF async event handlers are fire-and-forget by design
dotnet_diagnostic.CA2007.severity = none
# The app targets Windows only (WPF); platform-analyzer warnings are noise
dotnet_diagnostic.CA1416.severity = none
# Unused usings are cleaned by the IDE, not enforced by the build
dotnet_diagnostic.IDE0005.severity = suggestion

# Board is deliberately a stateless domain object with an instance API
# (state.Board.IsTrap(...)); making every method static would churn every call
# site in Core, Tests, and UI for no maintainability gain.
[**/Model/Board.cs]
dotnet_diagnostic.CA1822.severity = none

# Test method names follow the xUnit underscore convention
# (Method_Scenario_ExpectedResult) and are referenced by name in CLAUDE.md
# filter commands; CA1707 would rename the whole suite for no gain.
[JungleGame.Tests/**]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
