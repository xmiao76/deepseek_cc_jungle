<Window x:Class="JungleGame.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JungleGame.Desktop.Controls"
        xmlns:converters="clr-namespace:JungleGame.Desktop.Converters"
        Title="Jungle (Dou Shou Qi)" Height="720" Width="1020"
        MinWidth="800" MinHeight="600"
        Background="#FAFAFA"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToFirstMoveIndexConverter x:Key="BoolToFirstMoveIndexConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="🆕 New Game" Command="{Binding NewGameCommand}"
                        Style="{StaticResource ToolbarButton}" ToolTip="Start a new game (Human vs AI)"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>

                <Label Content="Difficulty:" VerticalAlignment="Center" FontSize="13" Margin="2,0"/>
                <ComboBox SelectedIndex="{Binding SelectedDifficulty}"
                          Style="{StaticResource ToolbarComboBox}" ToolTip="AI difficulty level">
                    <ComboBoxItem>Easy</ComboBoxItem>
                    <ComboBoxItem>Medium</ComboBoxItem>
                    <ComboBoxItem>Hard</ComboBoxItem>
                    <ComboBoxItem>Expert</ComboBoxItem>
                </ComboBox>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>

                <Label Content="First Move:" VerticalAlignment="Center" FontSize="13" Margin="2,0"/>
                <ComboBox SelectedIndex="{Binding IsHumanFirst, Converter={StaticResource BoolToFirstMoveIndexConverter}}"
                          Style="{StaticResource ToolbarComboBox}" ToolTip="Who moves first">
                    <ComboBoxItem>Human First</ComboBoxItem>
                    <ComboBoxItem>AI First</ComboBoxItem>
                </ComboBox>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>

                <Button Content="🔄 Flip Board" Command="{Binding ToggleFlipCommand}"
                        Style="{StaticResource ToolbarButton}" ToolTip="Flip the board display (visual only)"/>

                <Button Content="↩ Undo" Command="{Binding UndoCommand}"
                        Style="{StaticResource ToolbarButton}" ToolTip="Undo last move (not available during AI thinking)"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,0"/>

                <Button Content="🤖 AI vs AI" Command="{Binding AIVsAICommand}"
                        Style="{StaticResource ToolbarButton}" ToolTip="Watch two AI opponents play each other"/>
            </StackPanel>
        </Border>

        <!-- Row 1: Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidePanelBg}"
                    BorderBrush="#DDD" BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Blue captured pieces -->
                    <GroupBox Grid.Row="0" Header="🔵 Blue Captured">
                        <ListBox ItemsSource="{Binding BlueCapturedPieces}"
                                 Height="100" FontSize="11"
                                 Background="White" BorderBrush="#DDD"/>
                    </GroupBox>

                    <!-- Move history -->
                    <GroupBox Grid.Row="2" Header="📜 Move History" Margin="0,6,0,0">
                        <ListBox ItemsSource="{Binding MoveHistory}"
                                 FontSize="10" FontFamily="Consolas"
                                 Background="White" BorderBrush="#DDD"/>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Center: Board Area -->
            <Grid Grid.Column="1">
                <Viewbox Stretch="Uniform" Margin="10">
                    <controls:JungleBoardControl
                        x:Name="BoardControl"
                        Width="490" Height="630"
                        ViewModel="{Binding}"/>
                </Viewbox>
            </Grid>

            <!-- Right Sidebar -->
            <Border Grid.Column="2" Background="{StaticResource SidePanelBg}"
                    BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Turn indicator -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#DDD"
                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Current Turn" FontWeight="Bold" FontSize="12"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentTurnText}" FontSize="14"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Red captured pieces -->
                    <GroupBox Grid.Row="1" Header="🔴 Red Captured">
                        <ListBox ItemsSource="{Binding RedCapturedPieces}"
                                 Height="100" FontSize="11"
                                 Background="White" BorderBrush="#DDD"/>
                    </GroupBox>

                    <!-- Game Over panel -->
                    <Border Grid.Row="2" Margin="0,6,0,0" Padding="8"
                            Background="#FFF9E6" BorderBrush="#FFD700"
                            BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="🏆 Game Over!" FontSize="16"
                                       FontWeight="Bold" Foreground="#C80" TextAlignment="Center"/>
                            <TextBlock Text="{Binding GameOverMessage}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,6" TextAlignment="Center"
                                       Foreground="#444"/>
                            <Button Content="Play Again" Command="{Binding NewGameCommand}"
                                    HorizontalAlignment="Center" Padding="16,6"
                                    Background="#4CAF50" Foreground="White"
                                    BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBg}"
                BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🐘 Jungle (Dou Shou Qi)" FontSize="11" Foreground="#888"/>

                <!-- AI thinking indicator -->
                <ProgressBar Grid.Column="1" Width="120" Height="12"
                             IsIndeterminate="{Binding IsWaitingForAI}"
                             Visibility="{Binding IsWaitingForAI, Converter={StaticResource BoolToVisibilityConverter}}"
                             Margin="10,0" HorizontalAlignment="Left"/>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                           Foreground="#444" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
