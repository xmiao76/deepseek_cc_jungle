<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Window & panels ================= -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#252540" Offset="0"/>
        <GradientStop Color="#1A1A28" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2A3E"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A50"/>

    <!-- ================= Board ================= -->
    <SolidColorBrush x:Key="BoardFrameBrush" Color="#3D2B1F"/>
    <SolidColorBrush x:Key="LandBrush" Color="#E8C897"/>
    <SolidColorBrush x:Key="LandAltBrush" Color="#DFC08D"/>
    <LinearGradientBrush x:Key="RiverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4169E1" Offset="0"/>
        <GradientStop Color="#2149B1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RiverWaveBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TrapBrush" Color="#C94F4F"/>
    <SolidColorBrush x:Key="TrapMarkerBrush" Color="#FFEB3B"/>
    <SolidColorBrush x:Key="DenBrush" Color="#7A0000"/>
    <SolidColorBrush x:Key="DenFrameBrush" Color="#B30000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#3C281E"/>
    <SolidColorBrush x:Key="TerrainStrokeBrush" Color="#64503C"/>

    <!-- ================= Players ================= -->
    <SolidColorBrush x:Key="BluePieceBrush" Color="#4169E1"/>
    <SolidColorBrush x:Key="BluePieceDarkBrush" Color="#2149B1"/>
    <SolidColorBrush x:Key="BluePieceLightBrush" Color="#6E8EF0"/>
    <SolidColorBrush x:Key="RedPieceBrush" Color="#DC143C"/>
    <SolidColorBrush x:Key="RedPieceDarkBrush" Color="#B01030"/>
    <SolidColorBrush x:Key="RedPieceLightBrush" Color="#FF4D6D"/>

    <!-- ================= Accents ================= -->
    <SolidColorBrush x:Key="GoldBrush" Color="#FFD700"/>
    <SolidColorBrush x:Key="LegalMoveBrush" Color="#00CC00"/>
    <SolidColorBrush x:Key="CaptureMoveBrush" Color="#FF4444"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#64000000"/>

    <!-- ================= Buttons ================= -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#388E3C"/>
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#555555"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#404040"/>
    <SolidColorBrush x:Key="AccentButtonBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#FFB74D"/>
    <SolidColorBrush x:Key="AccentButtonPressedBrush" Color="#F57C00"/>
    <SolidColorBrush x:Key="DisabledButtonBrush" Color="#555555"/>

    <!-- ================= Text ================= -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>

    <!-- ================= Styles ================= -->

    <!-- Card: rounded panel used for status / captured / move log -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource PrimaryButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource PrimaryButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource DisabledButtonBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SecondaryButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SecondaryButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentButtonBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource GoldBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark radio/checkbox defaults -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
</ResourceDictionary>
